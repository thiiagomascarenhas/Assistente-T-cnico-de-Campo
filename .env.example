# ============================================================
# Evolution API (WhatsApp)
# ============================================================
# URL onde a Evolution API responde (a mesma exposta pelo docker-compose)
EVOLUTION_API_URL=http://localhost:8080

# Chave de API global da Evolution API (AUTHENTICATION_API_KEY no docker-compose)
# Usada para criar instancias e configurar webhooks.
EVOLUTION_GLOBAL_API_KEY=changeme-global-api-key

# Chave de API da instancia especifica (retornada ao criar a instancia).
# Se a Evolution API estiver configurada para usar a mesma global key, repita o valor acima.
EVOLUTION_API_KEY=changeme-instance-api-key

# Nome da instancia do WhatsApp que sera criada/conectada
EVOLUTION_INSTANCE=my-instance

# ============================================================
# Postgres (usado pelo docker-compose para a Evolution API)
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=evolution

# ============================================================
# Gemini API
# ============================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# Servidor da ponte (app.py)
# ============================================================
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000
